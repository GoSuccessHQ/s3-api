{
    "name": "gosuccess/s3-api",
    "description": "A modern, strongly-typed, dependency-free PHP client for S3-compatible object storage.",
    "type": "library",
    "license": "MIT",
    "keywords": [
        "s3",
        "object-storage",
        "aws",
        "signature-v4",
        "minio",
        "rustfs",
        "api",
        "client"
    ],
    "homepage": "https://github.com/GoSuccessHQ/s3-api",
    "readme": "README.md",
    "authors": [
        {
            "name": "GoSuccess GmbH",
            "homepage": "https://gosuccess.io"
        }
    ],
    "support": {
        "issues": "https://github.com/GoSuccessHQ/s3-api/issues",
        "source": "https://github.com/GoSuccessHQ/s3-api"
    },
    "require": {
        "php": "^8.4",
        "ext-curl": "*",
        "ext-libxml": "*",
        "ext-simplexml": "*"
    },
    "require-dev": {
        "friendsofphp/php-cs-fixer": "^3.95",
        "phpstan/phpstan": "^2.2",
        "phpunit/phpunit": "^13.3"
    },
    "autoload": {
        "psr-4": {
            "GoSuccess\\S3\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "GoSuccess\\S3\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "phpunit --testsuite unit",
        "test:integration": "phpunit --testsuite integration",
        "stan": "phpstan analyse --memory-limit=2G",
        "cs": "php-cs-fixer fix --dry-run --diff",
        "cs-fix": "php-cs-fixer fix",
        "check": [
            "@cs",
            "@stan",
            "@test"
        ],
        "rustfs:start": "docker run -d --rm --name s3-api-rustfs -p 127.0.0.1:9100:9000 --tmpfs /data:uid=10001,gid=10001,mode=0700 rustfs/rustfs:1.0.1 --address :9000 --access-key s3-api-test --secret-key s3-api-test-secret /data",
        "rustfs:stop": "docker stop s3-api-rustfs"
    },
    "config": {
        "platform": {
            "php": "8.4.1"
        },
        "sort-packages": true
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
